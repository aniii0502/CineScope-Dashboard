@model CineScope.Models.SeriesCredit

<a asp-controller="Series" asp-action="Details" asp-route-id="@Model.Id" class="movie-card">
    <div class="card-poster">
        <img src="@ImageHelper.GetImageUrl(Model.PosterPath)" alt="@Model.Name Poster" loading="lazy" />
    </div>
    <div class="card-info">
        <h3>@Model.Name</h3>
        @if (!string.IsNullOrEmpty(Model.Character))
        {
            <p>as @Model.Character</p>
        }
    </div>
</a>