@model CineScope.Models.Movie

<a asp-controller="Movies" asp-action="Details" asp-route-id="@Model.Id" class="movie-card">
    <div class="card-poster">
        <img src="@ImageHelper.GetImageUrl(Model.PosterPath)" alt="@Model.Title Poster" loading="lazy" />
    </div>
    <div class="card-info">
        <h3>@Model.Title</h3>
        <p>@Model.VoteAverage.ToString("0.0")/10</p>
    </div>
</a>