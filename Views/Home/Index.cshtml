@model CineScope.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home Page";
    var heroMovies = Model.PopularMovies.Take(5);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/movie-card.css" asp-append-version="true" />
}

<div class="hero-slider">
    <div class="slides-container">
        @foreach (var movie in heroMovies)
        {
            <div class="slide" style="background-image: url(@ImageHelper.GetImageUrl(movie.BackdropPath, "w1280"));">
                <div class="slide-overlay"></div>
                <div class="slide-content">
                    <h1>@movie.Title</h1>
                    <p>@movie.Overview</p>
                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id" class="btn-details">View
                        Details</a>
                </div>
            </div>
        }
    </div>
    <button class="slider-nav prev" id="slider-prev" title="Previous Slide">❮</button>
    <button class="slider-nav next" id="slider-next" title="Next Slide">❯</button>
</div>

<div class="main-container">
    <section class="content-section">
        <h2>🔥 Trending Movies</h2>
        <div class="card-carousel">
            @foreach (var movie in Model.PopularMovies)
            {
                <partial name="_MovieCard" model="movie" />
            }
        </div>
    </section>

    <section class="content-section">
        <h2>⭐ Top-Rated Series</h2>
        <div class="card-carousel">
            @foreach (var series in Model.TopRatedSeries)
            {
                <partial name="_SeriesCard" model="series" />
            }
        </div>
    </section>

    <section class="content-section">
        <h2>🎞️ Popular Movies</h2>
        <div class="card-carousel">
            @foreach (var movie in Model.UpcomingMovies)
            {
                <partial name="_MovieCard" model="movie" />
            }
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/pages/home.js" asp-append-version="true"></script>
}